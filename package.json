{
  "name": "practice-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/krate.mjs native dev",
    "dev:browser": "node scripts/krate.mjs native dev --browser",
    "build": "npm run build:engine && node scripts/krate.mjs native build",
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml",
    "package": "npm run build:engine && node scripts/package.mjs",
    "typecheck": "node scripts/krate.mjs native check && tsc --noEmit",
    "lint": "eslint src scripts && go vet ./api/... && cargo clippy --manifest-path engine/Cargo.toml --all-targets -- -D warnings",
    "test": "npm run test:unit && go test ./api/... && cargo test --manifest-path engine/Cargo.toml",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:native": "node scripts/krate.mjs native test"
  },
  "dependencies": {
    "@krate/app": "0.5.0-rc.13",
    "@krate/components": "0.5.0-rc.13",
    "@krate/core": "0.5.0-rc.13",
    "@krate/runtime": "0.5.0-rc.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.73.0"
  }
}
